## 4. API Integration Specs

### 4.1 Account Provisioning Endpoint (`POST /api/register`)

When the administrator submits the user creation form, an HTTP `POST` request is dispatched to `/api/register`.

#### HTTP Request Headers

```http
POST /api/register HTTP/1.1
Content-Type: application/json
Authorization: Bearer <ADMIN_JWT_TOKEN>

```

#### JSON Request Body

```json
{
  "first_name": "John",
  "last_name": "Doe",
  "email": "john.doe@example.com",
  "password": "SecurePassword123!",
  "role": "visa_staff"
}

```

#### Client JavaScript Logic

```javascript
const token = localStorage.getItem('token');
const user = JSON.parse(localStorage.getItem('user') || 'null');

// 1. Session & Role Verification
const logout = () => {
  localStorage.clear();
  window.location.href = '/login.html';
};

if (!token || user?.role !== 'admin') {
  logout();
} else {
  const fullName = `${user.first_name || ''} ${user.last_name || ''}`.trim() || 'Admin';
  document.getElementById('greetingName').textContent = fullName;
}

document.getElementById('logoutBtn').addEventListener('click', logout);

// 2. Modal Management
const createUserBtn = document.getElementById('createUserBtn');
const createUserModal = document.getElementById('createUserModal');
const createUserForm = document.getElementById('createUserForm');
const cancelBtn = document.getElementById('cancelBtn');
const createMsg = document.getElementById('createMsg');

createUserBtn.addEventListener('click', () => {
  createUserForm.reset();
  createMsg.textContent = '';
  createUserModal.showModal();
});

cancelBtn.addEventListener('click', () => {
  createUserModal.close();
});

// 3. Form Submission & API Request
createUserForm.addEventListener('submit', async (e) => {
  e.preventDefault();

  const first_name = document.getElementById('firstName').value.trim();
  const last_name = document.getElementById('lastName').value.trim();
  const email = document.getElementById('email').value.trim();
  const role = document.getElementById('role').value;
  const password = document.getElementById('password').value;
  const confirmPassword = document.getElementById('confirmPassword').value;

  createMsg.textContent = 'Creating account...';
  createMsg.style.color = 'black';

  // Client-side Password Match Check
  if (password !== confirmPassword) {
    createMsg.style.color = 'red';
    createMsg.textContent = 'Passwords do not match.';
    return;
  }

  try {
    const response = await fetch('/api/register', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${token}`
      },
      body: JSON.stringify({ first_name, last_name, email, password, role })
    });

    const data = await response.json();

    if (response.ok) {
      createMsg.style.color = 'green';
      createMsg.textContent = `User created successfully as "${data.user?.role || role}"!`;
      createUserForm.reset();
      setTimeout(() => {
        createUserModal.close();
      }, 1200);
    } else {
      createMsg.style.color = 'red';
      createMsg.textContent = data.error || data.message || 'Failed to create user.';
    }
  } catch (err) {
    console.error('User creation error:', err);
    createMsg.style.color = 'red';
    createMsg.textContent = 'Unable to connect to server.';
  }
});

```

